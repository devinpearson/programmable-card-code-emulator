{
  "name": "programmable-card-code-emulator",
  "version": "3.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "npm run ci",
    "build": "tsup",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ci": "npm run build && npm run typecheck && npm run lint && npm run check-exports",
    "check-exports": "attw --pack .",
    "test": "vitest",
    "local-release": "changeset version && changeset publish",
    "test:mutation": "stryker run"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "keywords": [
    "investec",
    "card",
    "emulator",
    "programmable banking",
    "open banking",
    "banking"
  ],
  "author": "Devin Pearson",
  "license": "MIT",
  "description": "An emulator for the Programmable Card Code Lamda function",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devinpearson/programmable-card-code-emulator.git"
  },
  "dependencies": {
    "isolated-vm": "^6.2.0",
    "moment-mini": "^2.29.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.5",
    "@changesets/cli": "^2.27.10",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "validator": "^13.11.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  }
}
